# Required for all model powered features. Keep server-side; never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Optional model version overrides; defaults are the current Muse model names used by the app.
META_WONDER_MODEL_ID=muse-wonder-1.0
META_SPARK_MODEL_ID=muse-spark-1.3
META_IMAGE_MODEL_ID=muse-image-1.0
META_SAM_MODEL_ID=sam-3.1

# Needed only if WhatsApp Cloud API integration is enabled.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional integrations
OPENAI_API_KEY=
GOOGLE_DRIVE_API_KEY=
GOOGLE_API_KEY=

# Optional transcription configuration
PIPELINE_B_WHISPER_MODEL=Xenova/whisper-base.en

# Hugging Face Cloud Storage Bucket (Media backend)
HF_TOKEN=
HF_BUCKET_ID=premspaw/zeroedits1

